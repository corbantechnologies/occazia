# Copy to .env.local for local work, and add the same keys in Vercel
# (Project → Settings → Environment Variables).

# Resend API key (resend.com → API Keys). Without it, forms show a WhatsApp fallback.
RESEND_API_KEY=

# Sender: an address on a domain verified in Resend.
ENQUIRY_FROM="Hotel Occazia Homa Bay <enquiries@occaziakenya.com>"

# Hotel inbox that receives every enquiry.
ENQUIRY_TO=info@occaziakenya.com

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to turn tracking off.
NEXT_PUBLIC_GA_ID=

# Set to 1 locally to log enquiry emails instead of sending them.
ENQUIRY_DRY_RUN=
